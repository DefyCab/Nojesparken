<Window x:Class="Nöjesparken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nöjesparken"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFF3DADA">
        <TextBox x:Name="txtBox" HorizontalAlignment="Left" Margin="95,50,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="52"/>
        <Button x:Name="btnCalculate" Content="BERÄKNA!" HorizontalAlignment="Left" Margin="94,128,0,0" VerticalAlignment="Top" Height="206" Width="456" Background="#FF21B3A2" FontSize="72" FontWeight="Bold" BorderThickness="10" BorderBrush="HotPink" Click="Calculate"/>
        <Label x:Name="label" Content="Skriv in din längd i cm" HorizontalAlignment="Left" Margin="94,19,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="checkBoxAdult" Content="Vuxen Medresenär" HorizontalAlignment="Left" Margin="345,76,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
